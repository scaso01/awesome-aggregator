# Awesome Aggregator Environment Variables
# Copy this file to .env and fill in values as needed

# Optional: YouTube Data API key (for extended metadata)
# Not required - YouTube RSS feeds work without an API key
# YOUTUBE_API_KEY=

# Optional: Reddit API credentials (for higher rate limits)
# Not required - Reddit .json endpoints work without auth
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# Server configuration (overrides config.yaml)
# HOST=0.0.0.0
# PORT=8000
